APP_ENV=production
BRAND_NAME_EN=EventLedger
BRAND_NAME_AR=إيفنت ليدجر
ROOT_DOMAIN=events-ye.services
NEXT_PUBLIC_ROOT_DOMAIN=events-ye.services
NEXT_PUBLIC_API_URL=https://api.events-ye.services
NEXT_PUBLIC_ENABLE_DEMO=false
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-64-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
S3_ENDPOINT=https://s3.events-ye.services
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_BUCKET=eventledger-assets
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-whatsapp-verify-token
GEMINI_API_KEY=
