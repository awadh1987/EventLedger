{
  "name": "eventledger-saas",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:native": "pnpm --filter web build:native",
    "build:exe": "pnpm build:native && pnpm --filter desktop build",
    "build:apk": "pnpm build:native && pnpm --filter mobile build:apk",
    "lint": "pnpm --filter web lint",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "api:migrate": "cd apps/api && alembic upgrade head",
    "api:seed": "cd apps/api && python seed.py",
    "api:test": "cd apps/api && python -m pytest -q"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
